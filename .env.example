# ==========================================
# 小说创作智能体系统 — 环境变量配置
# ==========================================
# 复制此文件为 .env 并填入真实值
#
# 注意：模型池和「智能体→模型」的映射关系在 conf/app_config.yaml 中配置。
#       本文件只负责存放 API 密钥等敏感信息。

# ═══════════════════════════════════════════════════════
# API 密钥（供 conf/app_config.yaml 中的 api_key_env 引用）
# ═══════════════════════════════════════════════════════

# DeepSeek 原生 API
DEEPSEEK_API_KEY=sk-your-deepseek-key

# 阿里百炼（示例：用于 qwen 模型）
# DASHSCOPE_API_KEY=sk-your-dashscope-key

# OpenAI
# OPENAI_API_KEY=sk-your-openai-key

# Anthropic
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-key

# 本地 Ollama（通常不需要真实密钥）
# OLLAMA_API_KEY=ollama

# ---------- Embedding 模型配置 ----------
EMBEDDING_API_KEY=sk-your-embedding-api-key
EMBEDDING_BASE_URL=https://api.deepseek.com
EMBEDDING_MODEL=qwen3.7-text-embedding

# ---------- 智能体温度配置 ----------
# 温度控制创意性 (0.0~2.0)，越高越有创意、越不稳定
ARCHITECT_TEMPERATURE=1.5
WRITER_TEMPERATURE=0.8
EDITOR_TEMPERATURE=0.2
READER_TEMPERATURE=0.5
SUPERVISOR_TEMPERATURE=0.1

# ---------- 智能体 max_tokens 配置（单次输出上限）----------
# writer 写正文需要最大输出；editor/reader/supervisor 只出报告，设小值省成本
ARCHITECT_MAX_TOKENS=200000
WRITER_MAX_TOKENS=200000
EDITOR_MAX_TOKENS=16384
READER_MAX_TOKENS=16384
SUPERVISOR_MAX_TOKENS=16384

# ---------- 记忆存储路径 ----------
SQLITE_DB_PATH=data/novels.db
CHROMA_DB_PATH=data/vector_db/

# ---------- 日志级别 ----------
LOG_LEVEL=INFO
